# boot/stock-boot-params.env — provenance record for boot-image parameters.
#
# Every parameter that build-bootimg.sh places into a deliverable boot
# image must be CONFIRMED here, with evidence from the stock fastboot ROM
# (P0-A offline measurement; see docs/bootimg-notes.md in the umbrella
# repo). Values marked UNVERIFIED block deliverable images — they may only
# be used with --allow-unverified (synthetic smoke artifacts).
#
# Format:  status:parameter=value
#   CONFIRMED:<param>=<value>   measured from stock images
#   UNVERIFIED:<param>=<value>  side-evidence / guess (OFRP tree, sheng, ...)
#
# OFRP side-evidence (NOT stock measurements): header v4, page size 4096,
# LZ4 ramdisk compression — see docs/bootimg-notes.md "side evidence".

UNVERIFIED:header_version=4
UNVERIFIED:pagesize=4096
UNVERIFIED:ramdisk_compression=lz4
UNVERIFIED:kernel_compression=gzip
UNVERIFIED:cmdline=console=ttyMSM0,115200n8
UNVERIFIED:dtb_offset=0x00000000
UNVERIFIED:tags_offset=0x00000000
