# boot/stock-boot-params.env — provenance record for boot-image parameters.
#
# Every parameter that build-bootimg.sh places into a deliverable boot
# image must be CONFIRMED here, with evidence from the stock fastboot ROM
# (P0-A offline measurement; evidence log: local/rom/parse-log.txt in the
# umbrella workspace). Values marked UNVERIFIED block deliverable images —
# they may only be used with --allow-unverified (synthetic smoke artifacts).
#
# Format:  status:parameter=value
#   CONFIRMED:<param>=<value>   measured from stock images (P0-A)
#   UNVERIFIED:<param>=<value>  side-evidence / guess (OFRP tree, sheng, ...)
#   POLICY:<param>=<rule>       deliberate operator choice (see rule)
#
# P0-A measurements (2026-09-18, ROM OS3.0.308.0.WPYCNXM,
# unpack_bootimg/mkdtboimg/file on images/{boot,vendor_boot,init_boot,dtbo}.img):
#   boot.img       — header v4, kernel = raw arm64 Image, ramdisk empty, cmdline empty
#   init_boot.img  — header v4, ramdisk LZ4-compressed
#   vendor_boot    — header v4, page size 0x1000 (4096), dtb @ 0x1f00000
#   dtbo.img       — table page_size 4096, v0, single entry

CONFIRMED:header_version=4
CONFIRMED:pagesize=4096
CONFIRMED:ramdisk_compression=lz4
CONFIRMED:kernel_compression=none

# The stock boot.img cmdline is empty (measured). A mainline boot passes its
# own console/cmdline deliberately; that is policy, not an unverified stock
# parameter — any operator cmdline is permitted once this marker is present.
POLICY:cmdline=operator-choice

# Not yet needed for deliverables; keep gated until measured into our images.
UNVERIFIED:dtb_offset=0x00000000
UNVERIFIED:tags_offset=0x00000000
