#!/bin/sh
# piano-collect — gather first-light evidence into one tarball.
#
# Usage: piano-collect [--output FILE]
#
# Collects dmesg, /proc and touch/display state into a gzip tarball
# (default /run/piano-evidence-<timestamp>.tar.gz) and prints the
# scp command to fetch it from the host over the USB-NCM link.

OUT=""
while [ $# -gt 0 ]; do
    case "$1" in
        --output) OUT=${2-}; shift 2 ;;
        -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
        *) echo "piano-collect: unknown option: $1" >&2; exit 2 ;;
    esac
done

STAGE=$(mktemp -d /tmp/piano-collect.XXXXXX)
trap 'rm -rf "$STAGE"' EXIT

mkdir -p "$STAGE/proc" "$STAGE/sys"

dmesg > "$STAGE/dmesg.txt" 2>/dev/null || dmesg > "$STAGE/dmesg.txt"

for f in cmdline version cpuinfo interrupts iomem ioports meminfo mounts \
         modules slabinfo devices bus/usb/devices; do
    cp "/proc/$f" "$STAGE/proc/$(echo "$f" | tr / _)" 2>/dev/null || true
done

for f in /sys/class/drm/*/status /sys/class/drm/*/enabled \
         /sys/class/graphics/fb0/virtual_size /sys/class/graphics/fb0/bits_per_pixel \
         /sys/class/backlight/*/brightness /sys/class/backlight/*/max_brightness \
         /proc/nvt_thp_status; do
    [ -e "$f" ] || continue
    dest="$STAGE/sys/$(echo "$f" | sed 's#^/sys/class/##; s#^/proc/##; s#/#_#g')"
    cp "$f" "$dest" 2>/dev/null || true
done

lspci > "$STAGE/lspci.txt" 2>/dev/null || true
lsmod > "$STAGE/lsmod.txt" 2>/dev/null || cat /proc/modules > "$STAGE/lsmod.txt"
uname -a > "$STAGE/uname.txt"
cat /proc/cmdline > "$STAGE/cmdline.txt" 2>/dev/null || true

NET=$(ip -o addr show usb0 2>/dev/null | awk '{print $4}')
[ -n "$NET" ] || NET=10.42.0.2/24

TS=$(date +%Y%m%d-%H%M%S)
OUT=${OUT:-/run/piano-evidence-$TS.tar.gz}
mkdir -p "$(dirname "$OUT")" 2>/dev/null || OUT="/tmp/piano-evidence-$TS.tar.gz"

tar -czf "$OUT" -C "$STAGE" . 2>/dev/null || {
    echo "piano-collect: tar failed" >&2
    exit 1
}

echo "piano-collect: wrote $OUT ($(wc -c < "$OUT") bytes)"
sha256sum "$OUT"
echo "fetch from the host with:"
echo "  scp root@10.42.0.2:$OUT ."
