#!/bin/sh
# piano-touch-test — exercise the NT36532E touch driver and stream touch
# frames to stdout (run over the USB-NCM SSH session or the console).
#
# Usage: piano-touch-test [--seconds N] [--max-frames N]
#
# The ported sheng driver deliberately has kernel_input disabled: it only
# publishes the THP proc interface (/proc/nvt_thp_raw|stream|status|stylus).
# Each stream record is a 32-byte little-endian header
#   magic u32, header_len u16, frame_len u16, sequence u64, timestamp_ns u64,
#   header_crc u16, flags u16, firmware_magic u32
# followed by frame_len bytes of event-buffer data. FLAG bit0 = frame valid,
# bit1 = epoch boundary.
#
# Exit codes: 0 = at least one valid frame seen; 1 = driver not probed;
# 2 = stream produced no frames.

SECONDS_TO_RUN=30
MAX_FRAMES=0

while [ $# -gt 0 ]; do
    case "$1" in
        --seconds)    SECONDS_TO_RUN=${2-}; shift 2 ;;
        --max-frames) MAX_FRAMES=${2-}; shift 2 ;;
        -h|--help)    sed -n '2,8p' "$0"; exit 0 ;;
        *) echo "piano-touch-test: unknown option: $1" >&2; exit 2 ;;
    esac
done

case "$SECONDS_TO_RUN" in ''|*[!0-9]*) echo "piano-touch-test: --seconds needs a number" >&2; exit 2 ;; esac
case "$MAX_FRAMES"     in ''|*[!0-9]*) echo "piano-touch-test: --max-frames needs a number" >&2; exit 2 ;; esac

if [ ! -e /proc/nvt_thp_status ]; then
    echo "piano-touch-test: /proc/nvt_thp_status missing — loading modules"
    modprobe spi-geni-qcom 2>&1
    modprobe nt36532e_ts 2>&1
    i=0
    while [ $i -lt 10 ] && [ ! -e /proc/nvt_thp_status ]; do
        sleep 1
        i=$((i + 1))
    done
fi

if [ ! -e /proc/nvt_thp_status ]; then
    echo "piano-touch-test: touch driver did not probe."
    echo "Hints: dmesg | grep -iE 'nv[tt]|spi|panel' — the driver defers"
    echo "probe until the DSI panel is prepared (DRM panel follower)."
    exit 1
fi

echo "== /proc/nvt_thp_status (before) =="
cat /proc/nvt_thp_status

echo
echo "== dmesg (touch-related) =="
dmesg 2>/dev/null | grep -iE 'nv[t65]|touch|panel' | tail -20

echo 1 > /proc/nvt_thp_raw 2>/dev/null || {
    echo "piano-touch-test: cannot enable capture (/proc/nvt_thp_raw)" >&2
    exit 2
}

echo
echo "== streaming touch frames for ${SECONDS_TO_RUN}s (touch the screen) =="

# Decode the byte stream: od emits 16 decimal bytes per line; the awk state
# machine collects bytes, parses headers and skips frame payloads.
timeout "$SECONDS_TO_RUN" cat /proc/nvt_thp_stream 2>/dev/null \
    | od -v -An -tu1 \
    | awk -v maxframes="$MAX_FRAMES" '
        function be(b, o, n,   v, i) { v = 0; for (i = 0; i < n; i++) v = v * 256 + b[o + i]; return v }
        function le(b, o, n,   v, i) { v = 0; for (i = n - 1; i >= 0; i--) v = v * 256 + b[o + i]; return v }
        {
            for (f = 1; f <= NF; f++) buf[nb++] = $f
            while (1) {
                if (!have_hdr) {
                    if (nb - pos < 32) break
                    magic = le(buf, pos, 4)
                    if (magic != 827348046) { pos++; continue }   # 0x3150544e "NTP1"
                    hlen = le(buf, pos + 4, 2)
                    flen = le(buf, pos + 6, 2)
                    seq  = le(buf, pos + 8, 8)
                    ts   = le(buf, pos + 16, 8)
                    crc  = le(buf, pos + 24, 2)
                    flg  = le(buf, pos + 26, 2)
                    fmag = le(buf, pos + 28, 4)
                    have_hdr = 1
                    pos += 32
                    if (flen > 8192) { have_hdr = 0; continue }   # implausible: resync
                    need = flen
                }
                if (nb - pos < need) break
                ev0 = buf[pos]; ev1 = buf[pos + 1]; ev2 = buf[pos + 2]
                printf "frame seq=%-6u flags=0x%04x %s ts=%ums crc=0x%04x fw=0x%08x ev=%02x %02x %02x\n", \
                       seq, flg, ((flg % 2 == 1) ? "VALID " : "inval "), ts % 4294967295, crc, fmag, ev0, ev1, ev2
                frames++
                if ((flg % 2) == 1) valid++
                if (maxframes > 0 && frames >= maxframes) { dump_all = 1; exit }
                pos += need
                have_hdr = 0
                if (pos > 262144) {   # compact the buffer periodically
                    rem = nb - pos
                    for (i = 0; i < rem; i++) buf[i] = buf[pos + i]
                    nb = rem; pos = 0
                }
            }
        }
        END {
            if (!dump_all && frames == 0 && nb == 0 && !no_data) no_data = 1
            printf "== summary: %d frames (%d valid) ==\n", frames, valid + 0
            if (frames == 0) exit 3
        }'
rc=$?

echo 0 > /proc/nvt_thp_raw 2>/dev/null

echo
echo "== /proc/nvt_thp_status (after) =="
cat /proc/nvt_thp_status

case $rc in
    0) exit 0 ;;
    3) echo "piano-touch-test: no frames arrived (IRQ not firing or capture off)" >&2; exit 2 ;;
    *) echo "piano-touch-test: stream reader stopped (rc=$rc)" >&2; exit 0 ;;
esac
