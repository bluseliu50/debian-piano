#!/bin/sh
# piano initramfs beaconinit — early bring-up debug environment.
#
# Boot contract: ABL v4 RAM boot concatenates the stock vendor_ramdisk after
# ours, so the entry point must NOT be /init; the kernel cmdline forces
# rdinit=/beaconinit (see build-initramfs.sh, which installs this file as
# both /init and /beaconinit).
#
# Phase order is deliberate:
#   1. beacon (bounded): proves userspace is alive on the framebuffer
#   2. UDC wait: dwc3 comes up via a long deferred-probe chain
#      (rpmhcc -> gcc -> icc -> rpmhpd -> phy -> dwc3), give it 120 s
#   3. NCM gadget + udhcpd + dropbear (static) — ssh is the primary access
#      path; busybox telnetd runs as an additional fallback
#   4. diagnostics dump printed AFTER the beacon stopped, so fbcon text
#      stays visible on screen (the beacon scrubs the framebuffer)
#   5. subsystem module loading (touch / WLAN / BT / remoteproc / battery /
#      audio). The initramfs has no udev: NOTHING autoloads — every module
#      the test matrix probes must be modprobed here (2026-09-22 lesson:
#      an image with the loading disabled fails every subsystem except
#      display and usb-net)

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

/bin/busybox --install -s /bin 2>/dev/null

CON=/dev/console
say() { echo "piano: $*" > "$CON" 2>/dev/null; echo "piano: $*"; }

mkdir -p /proc /sys /dev /run /tmp
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t configfs configfs /sys/kernel/config
# debugfs feeds piano-collect --verbose (gpio/pinctrl/clk/asoc tables);
# CONFIG_DEBUG_FS=y is already in piano_defconfig.
mkdir -p /sys/kernel/debug
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null \
    || say "WARN debugfs mount failed (verbose collect will lack debug tables)"

# --- framebuffer beacon (bounded) -------------------------------------------
# Alternate white/black fills of the whole splash framebuffer so userspace
# progress is visible with zero driver dependencies: /dev/fb0 when simpledrm
# bound, otherwise raw /dev/mem at the downstream cont_splash region
# 0xfc800000 (kernel built with STRICT_DEVMEM off). 20 rounds only — the
# beacon deliberately scrubs fbcon text, so all diagnostics are printed
# after it stops. /run/stop-beacon aborts it early.
(
  if [ -e /run/stop-beacon ]; then exit 0; fi
  FB=/dev/fb0
  [ -c "$FB" ] || FB=/dev/mem
  if [ -c "$FB" ]; then
    WHITE=/tmp/white.bin; BLACK=/tmp/black.bin
    head -c 1048576 /dev/zero | tr '\000' '\377' > "$WHITE"
    head -c 1048576 /dev/zero > "$BLACK"
    SEEK=0; [ "$FB" = /dev/mem ] && SEEK=$((0xfc800000 / 1048576))
    r=0
    while [ $r -lt 1 ]; do
      [ -e /run/stop-beacon ] && exit 0
      i=0; while [ $i -lt 28 ]; do
        dd if="$WHITE" of="$FB" bs=1048576 seek=$((SEEK + i)) count=1 2>/dev/null
        i=$((i + 1))
      done
      sleep 0.3
      i=0; while [ $i -lt 28 ]; do
        dd if="$BLACK" of="$FB" bs=1048576 seek=$((SEEK + i)) count=1 2>/dev/null
        i=$((i + 1))
      done
      sleep 0.3
      r=$((r + 1))
    done
  fi
) &

# --- wait for the DWC3 UDC (deferred probe chain) ----------------------------
say "waiting for UDC (dwc3 deferred-probe chain, up to 120s)"
UDC=""
w=0
while [ $w -lt 20 ]; do
  for u in /sys/class/udc/*; do [ -e "$u" ] && UDC=${u##*/} && break 2; done
  sleep 2
  w=$((w + 2))
  [ $((w % 60)) -eq 0 ] && say "still waiting for UDC (${w}s)"
done

# --- diagnostics (printed after the beacon stopped, so text survives) -------
diag() {
  say "=== DIAG2 udc='${UDC:-none}' ==="
  say "--- /sys/class/udc:"
  ls /sys/class/udc/ > "$CON" 2>&1
  say "--- usb/dwc3/phy lines (sync_state filtered):"
  dmesg | grep -iE 'dwc3|ssusb|eusb2|m31|qmp|udc|gadget|phy' | grep -vE 'sync_state|Fixed dependency' | tail -40 > "$CON" 2>&1
  say "--- EBUSY detail:"
dmesg | grep -iE 'EBUSY|can.t request' | tail -6 > "$CON" 2>&1
  say "--- qmp iomem + resources:"
  grep -iE '88e[0-9a-f]{4}' /proc/iomem > "$CON" 2>&1
  for d in /sys/bus/platform/devices/*ssphy*; do
    [ -d "$d" ] && { say "[$d]"; cat "$d/resources" > "$CON" 2>&1; }
  done
  say "--- probe failures/errors:"
dmesg | grep -iE 'fail|error|abort|unable' | grep -vE 'sync_state|deferr' | tail -15 > "$CON" 2>&1
}
diag_loop() {
  while [ ! -e /run/stop-diag ]; do
    diag
    say "(loop: touch /run/stop-diag to stop)"
    sleep 20
  done
}

if [ -z "$UDC" ]; then
  say "NO UDC after 120s — dumping probe state"
  diag_loop &
  exec setsid cttyhack /bin/sh
fi
say "UDC found: $UDC"

# --- USB NCM gadget ---------------------------------------------------------
GADGET=/sys/kernel/config/usb_gadget/piano
mkdir -p "$GADGET" || { diag; exec setsid cttyhack /bin/sh; }

echo 0x18d1 > "$GADGET/idVendor"   # Google
echo 0xd001 > "$GADGET/idProduct"  # generic NCM debug gadget
echo 0x0100 > "$GADGET/bcdDevice"
echo 0x0200 > "$GADGET/bcdUSB"

mkdir -p "$GADGET/strings/0x409"
echo "piano-linux"     > "$GADGET/strings/0x409/manufacturer"
echo "piano NCM debug" > "$GADGET/strings/0x409/product"
echo "0123456789"      > "$GADGET/strings/0x409/serialnumber"

mkdir -p "$GADGET/functions/ncm.usb0"
# Fixed test MACs: locally administered, collision-free on the point-to-point link
echo "02:11:22:33:44:55" > "$GADGET/functions/ncm.usb0/dev_addr"
echo "02:66:77:88:99:aa" > "$GADGET/functions/ncm.usb0/host_addr"

mkdir -p "$GADGET/configs/b.1/strings/0x409"
echo "ncm" > "$GADGET/configs/b.1/strings/0x409/configuration"
echo 500  > "$GADGET/configs/b.1/MaxPower"
ln -sf "$GADGET/functions/ncm.usb0" "$GADGET/configs/b.1"

echo "$UDC" > "$GADGET/UDC" || { say "gadget bind to $UDC FAILED"; diag; exec setsid cttyhack /bin/sh; }
say "NCM gadget bound to $UDC"

# --- Network on usb0 --------------------------------------------------------
ip link set usb0 up    || say "WARN ip link usb0 up failed"
ip addr add 10.42.0.2/24 dev usb0 || say "WARN ip addr usb0 failed"

cat > /tmp/udhcpd.conf <<EOF
interface usb0
start 10.42.0.10
end 10.42.0.20
opt dns 10.42.0.2
opt subnet 255.255.255.0
opt router 10.42.0.2
opt lease 3600
EOF
mkdir -p /var/lib/misc && touch /var/lib/misc/udhcpd.leases
udhcpd /tmp/udhcpd.conf >/run/udhcpd.log 2>&1 &
say "udhcpd launched (host: static 10.42.0.1/24)"

# --- ssh (static dropbear) + telnet fallback ---------------------------------
mkdir -p /etc/dropbear /root/.ssh
# The image ships a STATIC dropbear (musl), which runs in the bare initramfs.
# Keep a runtime probe anyway: if the binary ever goes dynamic again it
# silently fails to exec — detect that and still bring up telnetd.
if timeout 15 dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/run/dbk.log 2>&1; then
  dropbear -E -B -p 22 >/run/dropbear.log 2>&1 && say "dropbear (ssh) up on :22"
else
  say "dropbear unusable ($(head -c 80 /run/dbk.log 2>/dev/null)); ssh DOWN, telnet only"
fi
busybox telnetd -p 23 -l /bin/sh && say "telnetd up on :23" || say "WARN telnetd failed"

say "debug environment up: NCM 10.42.0.2, ssh/telnet root@10.42.0.2"

# --- subsystem module loading -------------------------------------------------
# No udev in the initramfs: without these modprobe calls the packed modules
# sit unused in /lib/modules and every subsystem except display (built-in)
# and usb-net shows FAIL. Failures are logged, never fatal.
load() { # load MODULE... — modprobe with console + log trail
    for m in "$@"; do
        if modprobe "$m" 2>>/run/modprobe.log; then
            say "modprobe $m ok"
        else
            say "modprobe $m FAILED (see /run/modprobe.log)"
        fi
    done
}

# battery/ADSP/audio: qrtr + our SERVREG_LOC daemon first (the kernel PDR
# client retries its lookups, but publishing early avoids a slow first
# attempt), then the remoteprocs, then pmic-glink + battmgr telemetry.
load qrtr
if command -v piano-pd-locator >/dev/null 2>&1; then
    ( piano-pd-locator >/dev/null 2>&1 ) &
    say "piano-pd-locator started (SERVREG_LOC on qrtr)"
else
    say "piano-pd-locator missing (battery/audio services will not come up)"
fi
load qcom_q6v5_pas
load pmic_glink
load qcom_battmgr

# pmic_glink_altmode is an aux-bus client — without udev nothing autoloads
# it. It is loaded AFTER the gadget is bound so a Type-C role event can
# never race the debug link up; the gadget already works without it.
load pmic_glink_altmode

# touch: SPI controller first; the touch driver defers until the DSI panel
# is prepared — display is built-in and already up by now, so a defer
# message here means a real panel-side problem, not ordering.
load spi-geni-qcom
load nt36532e_ts

# bluetooth: uart14's serdev child binds once hci_uart (with btqca and the
# pwrseq power-sequencing unit) is present; the QCA firmware download then
# runs on its own.
load pwrseq-qcom-wcn
load hci_uart

# wlan: pcie0 needs its QMP phy before ath12k can see the peach function;
# the MHI firmware download takes seconds — keep it off the interactive path.
load phy-qcom-qmp-pcie
( sleep 8
  modprobe ath12k_wifi7 2>>/run/modprobe.log || modprobe ath12k 2>>/run/modprobe.log \
      || say "modprobe ath12k FAILED (see /run/modprobe.log)"
) &

# audio: the audioreach stack needs the ADSP booted for several seconds
# before the sound card can register — deferred like ath12k.
( sleep 12
  if modprobe snd-soc-sc8280xp 2>>/run/modprobe.log; then
      say "modprobe snd-soc-sc8280xp ok"
  else
      say "modprobe snd-soc-sc8280xp FAILED (see /run/modprobe.log)"
  fi
  modprobe fastrpc 2>>/run/modprobe.log
) &

# Non-interactive boot smoke report in the background (after the module
# waves above had time to settle; probe results are polled live anyway).
if command -v piano-tests >/dev/null 2>&1; then
  ( sleep 20; piano-tests --auto > /run/boot-smoke.log 2>&1 ) &
fi

exec setsid cttyhack /bin/sh
